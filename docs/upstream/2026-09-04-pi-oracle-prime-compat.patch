--- /dev/null
+++ b/extensions/oracle/lib/host-compat.ts
@@ -0,0 +1,190 @@
+// Purpose: Isolate every optional host capability behind one feature-detecting module.
+// Responsibilities: Resolve the project config dir name, project-trust primitives, host mode, and theme usability without assuming a specific host build exports them.
+// Scope: Host capability probing only; oracle policy and filesystem behaviour stay in the modules that call these helpers.
+// Usage: Imported by lib/config.ts, lib/runtime.ts, lib/poller.ts, and index.ts instead of importing optional symbols directly.
+// Invariants/Assumptions: When the host exports a capability its value always wins, so behaviour on the reference pi build is byte-for-byte unchanged; fallbacks only run on hosts that omit the export.
+//
+// Why this module exists
+// ----------------------
+// `@earendil-works/pi-coding-agent` is a peer whose concrete implementation is
+// supplied by whichever host loads the extension. Hosts in the wild do not all
+// export the same surface: some export `CONFIG_DIR_NAME`, `ProjectTrustStore`
+// and `hasTrustRequiringProjectResources`, and some do not. Importing those
+// names directly makes the extension fail during module evaluation on a host
+// that omits them — as a bare `undefined` reaching `join()`, which is reported
+// far from its cause and, on hosts that swallow extension load errors, is not
+// reported at all.
+//
+// Every helper below therefore prefers the host's own value and only falls back
+// when the host does not provide one.
+
+import { homedir } from "node:os";
+import { isAbsolute, relative, sep } from "node:path";
+import * as host from "@earendil-works/pi-coding-agent";
+
+/**
+ * Last-resort project config dir name: the reference pi build's value.
+ * Only reachable on a host that exports neither `CONFIG_DIR_NAME` nor a usable
+ * `getAgentDir()`, which no known host does.
+ */
+const FALLBACK_CONFIG_DIR_NAME = ".pi";
+
+type OptionalHostSurface = {
+  CONFIG_DIR_NAME?: unknown;
+  getAgentDir?: unknown;
+  ProjectTrustStore?: unknown;
+  hasTrustRequiringProjectResources?: unknown;
+};
+
+const optionalHost = host as OptionalHostSurface;
+
+/**
+ * Read the host's default agent dir with any `*_CODING_AGENT_DIR` override
+ * neutralised.
+ *
+ * Hosts derive the default agent dir as `join(homedir(), CONFIG_DIR_NAME)` but
+ * let an environment variable relocate it. Only the *un*relocated value tells us
+ * the project-relative config dir name, so the override is removed for the
+ * duration of the call and restored in `finally`. This runs once, at module
+ * load, and only on hosts that do not export `CONFIG_DIR_NAME`.
+ */
+function defaultAgentDirIgnoringEnvOverride(): string | undefined {
+  const getAgentDir = optionalHost.getAgentDir;
+  if (typeof getAgentDir !== "function") return undefined;
+  const saved = new Map<string, string>();
+  for (const key of Object.keys(process.env)) {
+    if (/_CODING_AGENT_DIR$/.test(key)) {
+      const value = process.env[key];
+      if (value !== undefined) saved.set(key, value);
+      delete process.env[key];
+    }
+  }
+  try {
+    const resolved = (getAgentDir as () => string)();
+    return typeof resolved === "string" && resolved ? resolved : undefined;
+  } catch {
+    return undefined;
+  } finally {
+    for (const [key, value] of saved) process.env[key] = value;
+  }
+}
+
+function resolveConfigDirName(): string {
+  const declared = optionalHost.CONFIG_DIR_NAME;
+  if (typeof declared === "string" && declared.trim()) return declared;
+
+  const agentDir = defaultAgentDirIgnoringEnvOverride();
+  if (agentDir) {
+    const relativeToHome = relative(homedir(), agentDir);
+    if (
+      relativeToHome &&
+      !isAbsolute(relativeToHome) &&
+      !relativeToHome.split(sep).includes("..")
+    ) {
+      return relativeToHome.split(sep).join("/");
+    }
+  }
+  return FALLBACK_CONFIG_DIR_NAME;
+}
+
+/**
+ * The project-relative agent config dir name, e.g. `.pi` on the reference build.
+ *
+ * Resolved once at module load: the host's exported value when it has one,
+ * otherwise derived from the host's own default agent dir.
+ */
+export const CONFIG_DIR_NAME: string = resolveConfigDirName();
+
+/** The host's agent dir, honouring any environment override. */
+export function getAgentDir(): string {
+  const fn = optionalHost.getAgentDir;
+  if (typeof fn !== "function") {
+    throw new Error(
+      "Oracle requires the host to export getAgentDir() from @earendil-works/pi-coding-agent.",
+    );
+  }
+  return (fn as () => string)();
+}
+
+/**
+ * Whether the project contains resources whose use requires an explicit trust
+ * decision. Hosts without a project-trust model report `false`, which keeps the
+ * caller on its historical "load project config" path.
+ */
+export function hasTrustRequiringProjectResources(cwd: string): boolean {
+  const fn = optionalHost.hasTrustRequiringProjectResources;
+  if (typeof fn !== "function") return false;
+  return Boolean((fn as (cwd: string) => boolean)(cwd));
+}
+
+export interface OracleProjectTrustStore {
+  get(cwd: string): boolean | null;
+}
+
+/**
+ * The host's saved project-trust decisions, or `undefined` on a host with no
+ * project-trust model. Callers treat `undefined` as "the host has no opinion".
+ */
+export function createProjectTrustStore(agentDir: string): OracleProjectTrustStore | undefined {
+  const Ctor = optionalHost.ProjectTrustStore;
+  if (typeof Ctor !== "function") return undefined;
+  return new (Ctor as new (agentDir: string) => OracleProjectTrustStore)(agentDir);
+}
+
+// ---------------------------------------------------------------------------
+// Host run mode and UI capability
+// ---------------------------------------------------------------------------
+
+/** The host's declared run mode, or `undefined` on a host that does not expose one. */
+export function hostMode(ctx: { mode?: unknown }): string | undefined {
+  return typeof ctx.mode === "string" ? ctx.mode : undefined;
+}
+
+/**
+ * Whether this context can actually render themed status text.
+ *
+ * `ctx.hasUI` alone is not sufficient: a host may report `hasUI === true` in a
+ * non-interactive run while its theme is uninitialised, so that touching
+ * `ctx.ui.theme` throws. Because the oracle status refresh runs from an async
+ * lifecycle callback, that throw surfaces as an unhandled rejection and can take
+ * the host's session process down. Probing is the only reliable signal.
+ */
+export function canRenderThemedUi(ctx: { hasUI?: unknown; ui?: unknown }): boolean {
+  if (ctx.hasUI !== true) return false;
+  try {
+    const theme = (ctx.ui as { theme?: { fg?: unknown } } | undefined)?.theme;
+    if (!theme || typeof theme.fg !== "function") return false;
+    (theme.fg as (color: string, text: string) => string)("accent", "");
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Whether the poller should stay stopped for this context.
+ *
+ * On a host that declares its mode the historical rule is preserved exactly:
+ * only `print` and `json` suppress the poller. On a host that declares no mode,
+ * a context that cannot render themed UI is treated as non-interactive.
+ */
+export function isNonInteractiveHost(ctx: { mode?: unknown; hasUI?: unknown; ui?: unknown }): boolean {
+  const mode = hostMode(ctx);
+  if (mode !== undefined) return mode === "print" || mode === "json";
+  return !canRenderThemedUi(ctx);
+}
+
+/**
+ * Whether this context should receive the oracle prompt templates through
+ * `resources_discover`.
+ *
+ * The TUI path intercepts `/oracle` in the `input` handler and injects hidden
+ * dispatch instructions, so prompt templates are contributed only where that
+ * interception does not run. A host that declares no mode never takes the TUI
+ * interception branch, so it must receive the templates.
+ */
+export function needsPromptTemplateFallback(ctx: { mode?: unknown }): boolean {
+  const mode = hostMode(ctx);
+  if (mode === undefined) return true;
+  return ["print", "json", "rpc"].includes(mode);
+}
