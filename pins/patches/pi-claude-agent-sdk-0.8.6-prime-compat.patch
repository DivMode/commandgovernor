 	}
 
 	if (resolved?.auth.baseUrl) env.ANTHROPIC_BASE_URL = resolved.auth.baseUrl;
@@ -57,7 +63,10 @@
 
 	if (bearerToken) {
 		env.ANTHROPIC_AUTH_TOKEN = bearerToken;
-	} else if (resolved?.source?.toLowerCase().includes("oauth")) {
+	} else if (resolved?.source?.toLowerCase().includes("oauth") || credential?.startsWith("sk-ant-oat")) {
+		// Command Governor patch for Prime Agent: Prime labels stored credentials
+		// by storage ("stored"), not by kind, so an OAuth token is recognised by
