+
+/**
+ * Command Governor patch for Prime Agent: Prime's ModelRegistry has no
+ * getProviderAuth(); its credential resolver is getApiKeyAndHeaders(model).
+ * Resolve the `anthropic` provider's credential through whichever the
+ * registry offers, in the AuthResult shape the env builder expects.
+ */
+async function resolveAnthropicAuth(registry: AnthropicAuthRegistry): Promise<AuthResult | undefined> {
+	const anyRegistry = registry as unknown as {
+		getProviderAuth?: (provider: string) => Promise<AuthResult | undefined>;
+		getAll?: () => { provider: string }[];
+		getApiKeyAndHeaders?: (model: { provider: string }) => Promise<{ ok: boolean; apiKey?: string; headers?: Record<string, string>; env?: Record<string, string> }>;
+	};
+	if (typeof anyRegistry.getProviderAuth === "function") return anyRegistry.getProviderAuth("anthropic");
+	if (typeof anyRegistry.getAll !== "function" || typeof anyRegistry.getApiKeyAndHeaders !== "function") return undefined;
+	const model = anyRegistry.getAll().find((entry) => entry.provider === "anthropic");
+	if (!model) return undefined;
+	const result = await anyRegistry.getApiKeyAndHeaders(model);
+	if (!result?.ok || !result.apiKey) return undefined;
+	return {
+		auth: { apiKey: result.apiKey, headers: result.headers },
+		env: result.env,
+		source: result.apiKey.startsWith("sk-ant-oat") ? "prime:oauth" : "prime:stored",
+	} as unknown as AuthResult;
 }
