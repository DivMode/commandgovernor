+	/**
+	 * Command Governor patch for Prime Agent: would `resolveOrDerive` account for
+	 * this system prompt — without throwing, and without recording a diagnostic?
+	 *
+	 * Upstream Pi has no caller for this: every request Pi routes here is either
+	 * an agent turn (whose prompt `before_agent_start` recorded) or a nested
+	 * completion Pi already flagged `cacheRetention: "none"`. Prime has a third
+	 * kind — a nested completion carrying a short system prompt of its own that
+	 * `before_agent_start` never sees, and that Prime does not flag — so the
+	 * provider entry point needs to ask the question before it commits to the
+	 * path that throws. Same three routes as `resolveOrDerive`, in the same
+	 * order, with no side effects.
+	 *
+	 * An absent or empty prompt answers `false`, matching `resolveOrDerive`'s own
+	 * first line — but there it means "nothing to project", not "unaccountable",
+	 * and it does not throw. So `!canAccount(p)` is "resolveOrDerive would throw"
+	 * only for a truthy `p`; the caller carries that check.
+	 */
+	canAccount(systemPrompt?: string): boolean {
+		if (!systemPrompt) return false;
+		if (this.captures.has(systemPrompt)) return true;
+		if (this.reachableCaptures().some((node) => node.assembledPrompt === systemPrompt)) return true;
+		return this.findInheritedPrompts(systemPrompt, systemPrompt).length > 0;
+	}
+
 	get size(): number {
 		return this.captures.size;
 	}
