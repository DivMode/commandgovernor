--- a/src/served.ts	1969-12-31 14:00:00
+++ b/src/served.ts	2026-09-06 00:28:26
@@ -0,0 +1,137 @@
+// Served-model discipline for Command Governor's /gpt command.
+//
+// ChatGPT's backend reports THREE model fields on an assistant reply, and they
+// do not agree. `default_model_slug` merely ECHOES the slug the request asked
+// for — it is what gpt-6-astra-wm uses to lie, reporting the requested slug
+// while gpt-5-mini actually answered. The truth is `resolved_model_slug`, and
+// where that is absent, `model_slug`. So the served model is the first defined
+// of (resolved_model_slug, model_slug) — never default_model_slug.
+//
+// The firm rule (memory: gpt-command-no-fallback): if the served model is not
+// the requested one, the command errors LOUDLY and says exactly what happened.
+// It never retries on a lesser model and never silently downgrades. Reading the
+// served model on every reply and asserting it is the whole point of this file.
+
+/** The real served model of one assistant message's metadata, or null. */
+export function pickServedModel(metadata: unknown): string | null {
+  if (!metadata || typeof metadata !== "object") return null;
+  const md = metadata as Record<string, unknown>;
+  const resolved = md.resolved_model_slug;
+  if (typeof resolved === "string" && resolved) return resolved;
+  const slug = md.model_slug;
+  if (typeof slug === "string" && slug) return slug;
+  return null;
+}
+
+/**
+ * Read the served model from a full /backend-api/conversation/{id} detail
+ * document. Walks the active branch from current_node toward the root and
+ * returns the served model of the newest assistant message that carries one.
+ * Persistent chats only — a temporary chat 404s the readback, which surfaces
+ * before this is ever called.
+ */
+export function servedModelFromConversationDetail(detail: unknown): string | null {
+  if (!detail || typeof detail !== "object") return null;
+  const d = detail as { mapping?: Record<string, any>; current_node?: string };
+  const mapping = d.mapping || {};
+  const seen = new Set<string>();
+  let nodeId: string | undefined = d.current_node;
+  // Preferred: walk the active branch from the leaf.
+  while (nodeId && mapping[nodeId] && !seen.has(nodeId)) {
+    seen.add(nodeId);
+    const node = mapping[nodeId];
+    const msg = node?.message;
+    if (msg?.author?.role === "assistant") {
+      const served = pickServedModel(msg.metadata);
+      if (served) return served;
+    }
+    nodeId = node?.parent;
+  }
+  // Fallback: no current_node chain — take the newest assistant message anywhere.
+  let bestTime = -1;
+  let best: string | null = null;
+  for (const node of Object.values<any>(mapping)) {
+    const msg = node?.message;
+    if (msg?.author?.role !== "assistant") continue;
+    const served = pickServedModel(msg.metadata);
+    if (!served) continue;
+    const t = typeof msg.create_time === "number" ? msg.create_time : 0;
+    if (t >= bestTime) {
+      bestTime = t;
+      best = served;
+    }
+  }
+  return best;
+}
+
+/** True for a *-wm "work model" slug (gpt-6-astra-wm and any sibling). */
+export function isWorkModel(slug: string): boolean {
+  return /(^|[-_])wm$/i.test(slug) || /-wm-/i.test(slug);
+}
+
+/** True for a gpt-5-mini downgrade (what the *-wm liars actually serve). */
+export function isMiniModel(slug: string): boolean {
+  return /(^|[-_])mini($|[-_])/i.test(slug) || /gpt-5-mini/i.test(slug);
+}
+
+export class ServedModelError extends Error {
+  readonly requested: string;
+  readonly served: string | null;
+  constructor(message: string, requested: string, served: string | null) {
+    super(message);
+    this.name = "ServedModelError";
+    this.requested = requested;
+    this.served = served;
+  }
+}
+
+export interface AssertServedOptions {
+  /**
+   * How to judge the served model against the requested one.
+   *  - "exact" (default): served must equal requested.
+   *  - "family": served must START WITH requested (a family prefix, e.g.
+   *    "gpt-6-pro" accepting "gpt-6-pro-2026-xx"), and must not be a mini/wm
+   *    downgrade.
+   */
+  match?: "exact" | "family";
+  /** A label for the error message, e.g. "/gpt review (gpt)". */
+  context: string;
+}
+
+/**
+ * Assert the backend actually served the requested model. Throws a loud
+ * ServedModelError on a null read or any mismatch. No fallback, ever.
+ */
+export function assertServedModel(
+  served: string | null,
+  requested: string,
+  opts: AssertServedOptions,
+): void {
+  const { context } = opts;
+  const match = opts.match || "exact";
+  if (served === null) {
+    throw new ServedModelError(
+      `${context}: could not read the served model from ChatGPT's reply (no resolved_model_slug or model_slug). ` +
+        `Refusing to trust a reply whose model cannot be verified — requested ${requested}. No fallback.`,
+      requested,
+      served,
+    );
+  }
+  if (isWorkModel(served) || isMiniModel(served)) {
+    throw new ServedModelError(
+      `${context}: the backend served ${served} — a downgraded/work model — for a request for ${requested}. ` +
+        `This is the silent-downgrade failure the no-fallback rule exists to catch. Erroring instead of accepting it.`,
+      requested,
+      served,
+    );
+  }
+  const ok = match === "family" ? served.startsWith(requested) : served === requested;
+  if (!ok) {
+    throw new ServedModelError(
+      `${context}: requested ${requested} but the backend served ${served}. ` +
+        `The requested model was unavailable or intercepted; erroring loudly rather than falling back to a lesser model.`,
+      requested,
+      served,
+    );
+  }
+}
